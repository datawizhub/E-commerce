  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared pill action; compact admin heading overrides are documented separately.",
      "html": "<button class=\"ds-btn-primary\">Explore collection</button>",
      "css": ".ds-btn-primary{font-family:var(--font,Inter,Arial,Helvetica,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:13px 24px;border:1px solid var(--primary,#ff7448);border-radius:999px;font-size:14px;font-weight:600;line-height:1.55;cursor:pointer;transition:background-color .18s,color .18s,border-color .18s;background:var(--primary,#ff7448);color:var(--ink,#0f151d);border-color:var(--primary,#ff7448);}.ds-btn-primary:hover{background:var(--primary-hover,#ff8d69);border-color:var(--primary-hover,#ff8d69);}.ds-btn-primary:focus-visible{outline:2px solid var(--focus,#1d4ed8);outline-offset:4px;}.ds-btn-primary:disabled{opacity:.4;cursor:not-allowed;}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Shared pill action; compact admin heading overrides are documented separately.",
      "html": "<button class=\"ds-btn-secondary\">Cancel</button>",
      "css": ".ds-btn-secondary{font-family:var(--font,Inter,Arial,Helvetica,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:13px 24px;border:1px solid var(--primary,#ff7448);border-radius:999px;font-size:14px;font-weight:600;line-height:1.55;cursor:pointer;transition:background-color .18s,color .18s,border-color .18s;background:transparent;color:var(--ink,#0f151d);border-color:var(--line,#e2dcd8);}.ds-btn-secondary:hover{background:var(--secondary,#d3e1ff);}.ds-btn-secondary:focus-visible{outline:2px solid var(--focus,#1d4ed8);outline-offset:4px;}.ds-btn-secondary:disabled{opacity:.4;cursor:not-allowed;}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Shared pill action; compact admin heading overrides are documented separately.",
      "html": "<button class=\"ds-btn-danger\">Delete product</button>",
      "css": ".ds-btn-danger{font-family:var(--font,Inter,Arial,Helvetica,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:13px 24px;border:1px solid var(--primary,#ff7448);border-radius:999px;font-size:14px;font-weight:600;line-height:1.55;cursor:pointer;transition:background-color .18s,color .18s,border-color .18s;background:var(--error,#b42318);color:#fff;border-color:var(--error,#b42318);}.ds-btn-danger:hover{background:#8c2017;border-color:#8c2017;}.ds-btn-danger:focus-visible{outline:2px solid var(--focus,#1d4ed8);outline-offset:4px;}.ds-btn-danger:disabled{opacity:.4;cursor:not-allowed;}"
    },
    {
      "name": "Labelled Field",
      "kind": "input",
      "refersTo": "field",
      "description": "White shared field; form-section fields override its radius to 10px.",
      "html": "<label class=\"ds-field-label\">Product name<input class=\"ds-field\" placeholder=\"Everyday shirt\"></label>",
      "css": ".ds-field-label{font-family:var(--font,Inter,Arial,Helvetica,sans-serif);display:block;font-size:14px;font-weight:500;color:var(--ink,#0f151d);}.ds-field{font-family:var(--font,Inter,Arial,Helvetica,sans-serif);display:block;box-sizing:border-box;width:100%;min-height:43px;margin-top:7px;padding:10px 12px;border:1px solid var(--line,#e2dcd8);border-radius:var(--radius,12px);background:var(--surface,#fff);color:var(--ink,#0f151d);font-size:15px;line-height:1.55;transition:background-color .18s,color .18s,border-color .18s;}.ds-field:focus-visible{outline:2px solid var(--focus,#1d4ed8);outline-offset:4px;}.ds-field:read-only{background:var(--soft,#fff0e9);}"
    },
    {
      "name": "Store Navigation",
      "kind": "nav",
      "refersTo": "navigation-store",
      "description": "Inset white pill with active underline and coral promotion.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Store\"><a class=\"ds-wordmark\" href=\"#\">COMMON FORM</a><a href=\"#\" aria-current=\"page\">Shop</a><a class=\"ds-promo\" href=\"#\">Offers</a></nav>",
      "css": ".ds-nav{font-family:var(--font,Inter,Arial,Helvetica,sans-serif);display:flex;align-items:center;gap:25px;min-height:76px;padding:0 25px 0 30px;border-radius:999px;background:var(--surface,#fff);color:var(--ink,#0f151d);box-shadow:0 8px 24px #0f151d12;font-size:13px;}.ds-nav a{color:inherit;text-decoration:none;transition:background-color .18s,color .18s,border-color .18s;}.ds-nav a:hover{text-decoration:underline;}.ds-nav a:focus-visible{outline:2px solid var(--focus,#1d4ed8);outline-offset:4px;}.ds-nav [aria-current]{text-decoration:underline;text-decoration-color:var(--accent-ink,#c84d28);text-decoration-thickness:2px;}.ds-wordmark{font-size:22px;font-weight:650;letter-spacing:-.04em;margin-right:auto;}.ds-promo{background:var(--primary,#ff7448);border-radius:999px;padding:10px 18px;font-weight:500;}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Compact informational status; pale blue replaces the previous green class styling.",
      "html": "<span class=\"ds-badge\">Draft</span> <span class=\"ds-badge ds-badge-status\">Active</span>",
      "css": ".ds-badge{font-family:var(--font,Inter,Arial,Helvetica,sans-serif);display:inline-flex;align-items:center;background:var(--soft,#fff0e9);color:var(--muted,#5c626a);border-radius:999px;padding:4px 9px;font-size:11px;line-height:1.55;text-transform:capitalize;white-space:nowrap;}.ds-badge-status{background:var(--secondary,#d3e1ff);color:#273c62;}"
    },
    {
      "name": "Workspace Panel",
      "kind": "card",
      "refersTo": "form-section",
      "description": "Flat, fine-bordered working panel with compact corners.",
      "html": "<section class=\"ds-panel\"><h2>Product details</h2><p>Manage the garment information.</p></section>",
      "css": ".ds-panel{font-family:var(--font,Inter,Arial,Helvetica,sans-serif);padding:26px;background:var(--surface,#fff);color:var(--ink,#0f151d);border:1px solid var(--line,#e2dcd8);border-radius:16px;}.ds-panel h2{font-size:19px;font-weight:500;line-height:1.15;letter-spacing:-.015em;margin:0 0 22px;}.ds-panel p{font-size:13px;line-height:1.55;margin:0;}@media(max-width:700px){.ds-panel{padding:22px 18px;border-radius:14px;}}"
    },
    {
      "name": "Variant Choice",
      "kind": "chip",
      "refersTo": "button-secondary",
